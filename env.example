# Alcohol Label Verification App - Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_DB=alcohol_label_verification
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Database URL (automatically constructed from above values)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/alcohol_label_verification

# =============================================================================
# GOOGLE CLOUD CONFIGURATION
# =============================================================================
# Get your Gemini API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Your Google Cloud Project ID
GCP_PROJECT_ID=your_gcp_project_id_here

# Google Cloud Storage bucket name for storing uploaded images
GCS_BUCKET_NAME=your_gcs_bucket_name_here

# Path to Google Cloud service account key file (optional if using default credentials)
# GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/service-account-key.json

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Default user role: 'admin' or 'submitter'
DEFAULT_ROLE=admin

# Streamlit server configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# =============================================================================
# PRODUCTION CONFIGURATION (for Linux VM deployment)
# =============================================================================
# Domain name for SSL certificates
# DOMAIN_NAME=your-domain.com

# Email for Let's Encrypt SSL certificates
# LETSENCRYPT_EMAIL=your-email@example.com

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Set to 'development' for local development, 'production' for production
ENVIRONMENT=development

# Enable debug mode (true/false)
DEBUG=true
